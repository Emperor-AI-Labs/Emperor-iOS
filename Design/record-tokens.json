  "gradient": {
    "primary": {
      "angle": 135,
      "light": [
        "#464E85",
        "#547592"
      ],
      "dark": [
        "#4D568F",
        "#5A7C9A"
      ],
      "use": "the ONE primary action per screen, the send button, avatar, FAB"
