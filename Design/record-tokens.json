    "bodyStrong": {
      "font": "ui",
      "weight": 600,
      "ios": {
        "size": 17,
        "line": 22
      },
      "android": {
        "size": 16,
        "line": 22
      }
    },
    "callout": {
      "font": "ui",
      "weight": 500,
      "ios": {
        "size": 15,
        "line": 20
      },
      "android": {
        "size": 14,
        "line": 20
      }
