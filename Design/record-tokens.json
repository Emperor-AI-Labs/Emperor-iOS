      "android": {
        "size": 21,
        "line": 28,
        "weight": 500
      }
    },
    "body": {
      "font": "ui",
      "weight": 400,
      "ios": {
        "size": 17,
        "line": 25
      },
      "android": {
        "size": 16,
        "line": 24
      }
