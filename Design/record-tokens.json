  "font": {
    "display": {
      "family": "Instrument Serif",
      "weights": [
        400
      ],
      "italic": true,
      "license": "OFL",
      "fallback": [
        "Iowan Old Style",
        "Georgia",
        "serif"
      ],
      "use": "large titles, greetings, item numbers, dialog titles (Android), document titles"
    },
    "ui": {
      "family": "Plus Jakarta Sans",
      "weights": [
        400,
        500,
        600,
        700
      ],
      "license": "OFL",
      "fallback": [
        "SF Pro Text",
        "Roboto",
        "system-ui"
      ],
      "use": "everything else"
    },
    "document": {
      "family": "Iowan Old Style / Noto Serif",
      "use": "rendered pages of the user's documents and the draft body"
    }
  },
  "type": {
    "largeTitle": {
      "font": "display",
